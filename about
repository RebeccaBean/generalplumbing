  <script>
    (function () {
      const root = document.getElementById("gp-about");
      if (!root) return;

      const menuButton = root.querySelector(".gp-menu-toggle");
      const navLinks = root.querySelector(".gp-links");

      if (menuButton && navLinks) {
        menuButton.addEventListener("click", function () {
          const isOpen = navLinks.classList.toggle("gp-open");
          menuButton.setAttribute("aria-expanded", String(isOpen));
          menuButton.setAttribute(
            "aria-label",
            isOpen ? "Close navigation" : "Open navigation"
          );
          menuButton.textContent = isOpen ? "✕" : "☰";
        });

        navLinks.querySelectorAll("a").forEach(function (link) {
          link.addEventListener("click", function () {
            navLinks.classList.remove("gp-open");
            menuButton.setAttribute("aria-expanded", "false");
            menuButton.setAttribute("aria-label", "Open navigation");
            menuButton.textContent = "☰";
          });
        });
      }

      const year = root.querySelector("#gp-current-year");
      if (year) year.textContent = new Date().getFullYear();

      const form = root.querySelector("#gp-inquiry-form");
      const message = root.querySelector("#gp-form-message");

      if (form && message) {
        form.addEventListener("submit", function (event) {
          event.preventDefault();
          message.style.display = "block";
          message.textContent =
            "This demo form is not connected yet, so your inquiry has not been sent. Please call 760-376-3309, or connect this form to your HighLevel CRM before publishing.";
        });
      }
    })();
  </script>
